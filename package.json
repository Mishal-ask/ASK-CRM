{
  "name": "supanext",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run typecheck",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:regression": "node --test tests/parity.test.mjs",
    "test:e2e:public": "playwright test --grep-invert Hosted",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:typegen": "node scripts/db-typegen.mjs",
    "email:dev": "npm --prefix transactional-emails run dev",
    "email:export": "npm --prefix transactional-emails run export"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
