NEXT_PUBLIC_SUPABASE_URL=https://iqzoulaonwloyqgrljbg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sUiSUQSL_0yC0GQYXljvTw_hdkYkDSb
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ASK-CRM

# Optional integrations. Both remain disabled when blank.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_CHANNEL_PLUGIN_KEY=

# Server-only Supabase secret key, required for account deletion and isolated
# hosted Playwright users. Legacy projects may use SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Supavisor transaction-pooler URL used by the serverless application runtime.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-region.pooler.supabase.com:6543/postgres

# Public DSN used by the browser, server, and edge Sentry SDKs.
NEXT_PUBLIC_SENTRY_DSN=

# Keep false in normal production use. Enable only while verifying Sentry.
SENTRY_DEBUG_ENABLED=false

# Required only in CI for source-map uploads.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Contact form. Supaplate demonstrates both CAPTCHA providers at once; most
# applications should keep one provider and remove the other widget/check.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend sender must use a verified domain. Also used by the queued mailer.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Supanext <hello@example.com>
ADMIN_EMAIL=admin@example.com

# Toss Payments widget and server API keys. Start with test keys.
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=

# Supabase Cron sends this exact value as the Authorization header on POST requests.
# Use a random value with at least 16 characters.
CRON_SECRET=

# Dedicated hosted test accounts. Never use production accounts.
# Tests create and clean up scenario/browser-specific plus aliases of these addresses.
JOIN_TEST_UNCONFIRMED_USER_EMAIL=
JOIN_TEST_EXISTING_USER_EMAIL=
LOGIN_TEST_USER_EMAIL=
FORGOT_PASSWORD_TEST_USER_EMAIL=
MAGIC_LINK_TEST_USER_EMAIL=
CHANGE_EMAIL_TEST_USER_EMAIL=
CHANGE_EMAIL_TEST_USER_NEW_EMAIL=
CHANGE_PASSWORD_TEST_USER_EMAIL=
EDIT_PROFILE_TEST_USER_EMAIL=
DELETE_PROFILE_TEST_USER_EMAIL=
